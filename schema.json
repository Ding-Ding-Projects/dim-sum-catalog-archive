{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ding-Ding-Projects/agent-global-memory/blob/main/dim-sum/schema.json",
  "title": "Hong Kong dim sum and dish catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogStatus",
    "title",
    "total",
    "imageSpecification",
    "dishes",
    "indexes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "catalogStatus": {
      "enum": ["in-progress", "complete"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "imageSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "mediaType", "quality", "minimumWidth", "minimumHeight", "generationMode"],
      "properties": {
        "format": { "const": "png" },
        "mediaType": { "const": "image/png" },
        "quality": { "const": "native-lossless-imagegen-output" },
        "minimumWidth": { "const": 1024 },
        "minimumHeight": { "const": 1024 },
        "generationMode": { "const": "one-distinct-built-in-imagegen-call-per-dish" }
      }
    },
    "dishes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dish" }
    },
    "indexes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byId", "bySlug", "byCategory"],
      "properties": {
        "byId": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "bySlug": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byCategory": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zhHant"],
      "properties": {
        "en": { "type": "string", "minLength": 2 },
        "zhHant": { "type": "string", "minLength": 1 }
      }
    },
    "localizedCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "yue"],
      "properties": {
        "en": { "type": "string", "minLength": 8 },
        "yue": { "type": "string", "minLength": 4 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "alt"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^images/hk-dish-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.png$"
        },
        "alt": { "$ref": "#/$defs/localizedCopy" }
      }
    },
    "dish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "jyutping",
        "category",
        "subcategory",
        "description",
        "ingredients",
        "dietaryTags",
        "allergens",
        "image",
        "imagePrompt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^hk-dish-[0-9]{4}$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "$ref": "#/$defs/localizedName" },
        "jyutping": { "type": "string", "minLength": 2 },
        "category": { "type": "string", "minLength": 2 },
        "subcategory": { "type": "string", "minLength": 2 },
        "description": { "$ref": "#/$defs/localizedCopy" },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dietaryTags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "allergens": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "image": { "$ref": "#/$defs/image" },
        "imagePrompt": { "type": "string", "minLength": 100 },
        "chocolateFilled": { "type": "boolean", "const": true }
      }
    }
  }
}
